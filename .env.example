# =====================================================================
# TruthLens Full-Stack Environment Variables Reference
# =====================================================================

# ---------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Paste into Vercel Dashboard)
# ---------------------------------------------------------------------
# Note: The frontend communicates ONLY with our backend. No third-party
# news or AI API keys should ever be stored in the frontend client.
VITE_API_URL=https://truthlens-api.onrender.com/api
VITE_API_BASE_URL=https://truthlens-api.onrender.com/api
VITE_APP_NAME=TruthLens
VITE_DEFAULT_LANG=en
VITE_DEFAULT_THEME=dark

# ---------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Render / Railway / VPS / Cloud Run)
# ---------------------------------------------------------------------
# Environment mode ('development' or 'production').
# When ENV=production, the server will refuse to start if SECRET_KEY or
# admin credentials are empty or match known insecure placeholders.
ENV=development

# Mandatory in production: generate a cryptographically strong 64-char hex secret (e.g. `openssl rand -hex 32`)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Portal Credentials
ADMIN_EMAIL=admin@truthlens.ai
# Set ADMIN_PASSWORD for development, or ADMIN_PASSWORD_HASH (bcrypt) for production
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# CORS Allowed Origins (comma-separated list).
# CRITICAL: https://truthlens-frontend-five.vercel.app MUST be included for production Vercel frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://truthlens-frontend-five.vercel.app,https://truthlens.vercel.app

# CORS Origin Regex for Vercel preview branch deployments (e.g. https://truthlens-git-*.vercel.app)
CORS_ORIGIN_REGEX=^https:\/\/truthlens-.*\.vercel\.app$

# Set to true when running behind reverse proxy (Render, Cloudflare, AWS ALB) so client IP is read from X-Forwarded-For
TRUST_PROXY=false

# Engine Thresholds & Rate Limiting (per-process; multi-worker requires Redis)
RATE_LIMIT_PER_MINUTE=60
CONFIDENCE_THRESHOLD_TRUE=80.0
CONFIDENCE_THRESHOLD_PARTIAL=55.0

# ---------------------------------------------------------------------
# 3. AI & LIVE NEWS PROVIDER APIs (Optional - RSS + GDELT run with 0 keys!)
# ---------------------------------------------------------------------
# Google Gemini API key for deep reasoning (optional, deterministic fallback active)
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=

# Tier 2 News Providers (Free tier, near real-time)
# The Guardian Open Platform (Developer tier, 500 req/day): https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=
# Currents API (Free tier, 600 req/day): https://currentsapi.services/en
CURRENTS_API_KEY=

# Tier 3 News Providers (Free tier, ~12-24h delayed backup)
# NewsData.io (Free tier, 200 credits/day): https://newsdata.io/
NEWSDATA_API_KEY=
# GNews (Free tier, 100 req/day): https://gnews.io/
GNEWS_API_KEY=
# NewsAPI.org (Dev only / localhost): https://newsapi.org/
NEWS_API_KEY=

# Google Fact Check Tools API (Free key from Google Cloud Console):
# https://toolbox.google.com/factcheck/apis
GOOGLE_FACTCHECK_API_KEY=

# ---------------------------------------------------------------------
# 4. PERSISTENCE STORAGE (Firestore recommended for production Render)
# ---------------------------------------------------------------------
# Local JSON file storage is wiped on Render free-tier redeploys.
# Firestore provides persistent cross-deploy storage.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
