# =====================================================================
# TruthLens Frontend - Vercel Environment Variables
# Copy and paste this directly into Vercel Settings -> Environment Variables
# =====================================================================

# Backend API Endpoint (Replace with your live hosted backend URL)
VITE_API_URL=https://truthlens-api.onrender.com/api
VITE_API_BASE_URL=https://truthlens-api.onrender.com/api

# Application Defaults
VITE_APP_NAME=TruthLens
VITE_DEFAULT_LANG=en
VITE_DEFAULT_THEME=dark

# Real-Time News APIs with Original Images (Optional - High-fidelity fallback active if empty)
# 1. NewsData.io (Recommended: 200 free requests/day): https://newsdata.io
VITE_NEWSDATA_API_KEY=

# 2. GNews.io (100 free requests/day): https://gnews.io
# Serverless Function environment variable (used by /api/news):
GNEWS_API_KEY=
# Vite client environment variable (fallback if calling direct):
VITE_GNEWS_API_KEY=

# 3. MediaStack (500 free requests/month): https://mediastack.com
VITE_MEDIASTACK_API_KEY=

