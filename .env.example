# =====================================================================
# TruthLens Platform Environment Configuration Template
# Copy this file to .env and configure your environment variables.
# NEVER commit your actual .env file or private credentials to git.
# =====================================================================

# ---------------------------------------------------------------------
# Backend Core & Authentication
# ---------------------------------------------------------------------
# Generate a strong random key for JWT signing (e.g., openssl rand -hex 32)
SECRET_KEY=your_random_32_byte_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Administrator Credentials (Used to authenticate to the Admin Suite)
ADMIN_EMAIL=admin@truthlens.ai
ADMIN_PASSWORD=SetYourStrongAdminPassword2026!

# CORS Allowed Origins (Comma-separated list of trusted frontend origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting & Verification Thresholds
RATE_LIMIT_PER_MINUTE=60
CONFIDENCE_THRESHOLD_TRUE=80.0
CONFIDENCE_THRESHOLD_PARTIAL=55.0

# ---------------------------------------------------------------------
# External Intelligence APIs (Optional - Curated offline failovers active)
# ---------------------------------------------------------------------
# Google Gemini Generative AI API Key
GEMINI_API_KEY=

# NewsAPI.org API Key (Optional)
NEWS_API_KEY=

# Custom Search API Key (Optional)
SEARCH_API_KEY=

# GNews.io API Key (Optional)
GNEWS_API_KEY=

# Google Fact Check Tools API Key (Optional)
GOOGLE_FACTCHECK_API_KEY=

# ---------------------------------------------------------------------
# Firebase Cloud Firestore Integration (Backend Server-Side ONLY)
# NEVER expose FIREBASE_CLIENT_EMAIL or FIREBASE_PRIVATE_KEY to frontend
# ---------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------
# Frontend Environment Variables (Vite Client-Side)
# ---------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api
VITE_API_BASE_URL=http://localhost:8000/api
