# =====================================================================
# TruthLens Frontend - Vercel Environment Variables Reference
# =====================================================================

# Default to same-origin Vercel Serverless Function (/api)
VITE_API_BASE_URL=/api
VITE_API_URL=/api

# Application Defaults
VITE_APP_NAME=TruthLens
VITE_DEFAULT_LANG=en
VITE_DEFAULT_THEME=dark

# Optional: Client-Side Real-Time Firestore Listeners
# Configure to receive instant fact-check updates across browser tabs
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
