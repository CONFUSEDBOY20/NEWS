rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check admin role
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.role == 'admin' || 
         request.auth.token.email.matches('.*@truthlens[.]ai'));
    }

    // Public readable fact checks and evidence
    match /fact_checks/{document} {
      allow read: if true;
      allow create: if true; // Anonymous verification submissions allowed
      allow update, delete: if isAdmin();
    }

    match /claims/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /evidence/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Raw Fact Data (Controlled by Admins)
    match /raw_data/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fact Articles (News/Investigative Editorial Desk)
    match /fact_articles/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // News Cache (Aggregated Feeds)
    match /news_cache/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Logs and System Settings
    match /admin_logs/{document} {
      allow read, write: if isAdmin();
    }

    match /system_settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{document} {
      allow read, write: if isAdmin();
    }
  }
}
