# =====================================================================
# TruthLens Full-Stack Environment Variables Reference
# =====================================================================

# ---------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel Dashboard)
# ---------------------------------------------------------------------
# In full-stack Vercel deployments, the frontend communicates with the
# same-origin serverless function backend at /api (eliminating Render cold starts).
VITE_API_BASE_URL=/api
VITE_API_URL=/api
VITE_APP_NAME=TruthLens
VITE_DEFAULT_LANG=en
VITE_DEFAULT_THEME=dark

# Optional: Real-time Multi-Tab Firestore Listeners (client-side)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------
# 2. VERCEL SERVERLESS BACKEND CONFIGURATION
# ---------------------------------------------------------------------
# Environment mode ('development' or 'production').
ENV=production

# Mandatory in production: generate a cryptographically strong 64-char hex secret (e.g. `openssl rand -hex 32`)
SECRET_KEY=9f834a81b2c7e6d5a4f3e2d1c0b9a876543210fedcba9876543210abcdef1234_replace_me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Portal Credentials
ADMIN_EMAIL=admin@truthlens.ai
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# CORS Configuration: Allows preview and production Vercel domains (*.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://truthlens.vercel.app
CORS_ORIGIN_REGEX=^https:\/\/(?:[a-zA-Z0-9-]+\.)?vercel\.app$

# Reverse proxy trust
TRUST_PROXY=true

# Engine Thresholds & Rate Limiting
RATE_LIMIT_PER_MINUTE=60
CONFIDENCE_THRESHOLD_TRUE=80.0
CONFIDENCE_THRESHOLD_PARTIAL=55.0

# ---------------------------------------------------------------------
# 3. AI & LIVE NEWS PROVIDER APIs
# ---------------------------------------------------------------------
# Google Gemini API key for deep reasoning & real-time streaming (SSE)
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=

# NewsData.io (Free tier, 200 credits/day): https://newsdata.io/
NEWSDATA_API_KEY=

# Google Fact Check Tools API (Free key from Google Cloud Console):
# https://toolbox.google.com/factcheck/apis
GOOGLE_FACT_CHECK_API_KEY=
GOOGLE_FACTCHECK_API_KEY=

# Optional Tier 2 & Tier 3 News Providers
GUARDIAN_API_KEY=
CURRENTS_API_KEY=
GNEWS_API_KEY=
NEWS_API_KEY=

# ---------------------------------------------------------------------
# 4. PERSISTENCE STORAGE (Firebase Firestore /tmp fallback)
# ---------------------------------------------------------------------
# Firebase Service Account Credentials for server-side persistence.
# Can be provided as a full JSON string (single env var for Vercel) or as a file path:
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=

# Alternatively, individual Firebase service account fields:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
